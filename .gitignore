# Environment — setiap server punya .env sendiri, JANGAN commit
.env
!.env.example

# Session files
.sessions/
*.session

# Logs
 Reqtrace.log
*_reqtrace.log
logs/
*.log

# Rate limits (generated at runtime)
storage/rate_limits/

# Uploaded files — per-tenant, bukan bagian dari source code
assets/uploads/logos/*
assets/uploads/students/*
assets/uploads/webcam/*
!assets/uploads/logos/.gitkeep
!assets/uploads/students/.gitkeep
!assets/uploads/webcam/.gitkeep

# Composer — JANGAN ignore (shared hosting tidak bisa composer install)
# vendor/ sudah di-commit agar deploy ke cPanel langsung jalan
# /vendor/
# composer.lock

# Node
/node_modules/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Scratch & debug
scratch/
_reqtrace.log
.test_cj.txt
.verify_cookies.txt
$PROFILE.txt
