# ==============================================================================
# CBT ONLINE MULTI-TENANT — ENVIRONMENT CONFIGURATION (PRODUCTION)
# ==============================================================================

# Database Settings — SESUAIKAN dengan kredensial MySQL di cPanel Anda
CBT_DB_HOST=127.0.0.1
CBT_DB_PORT=3306
CBT_DB_NAME=cbtonline_db
CBT_DB_USER=root
CBT_DB_PASS=

# Environment Mode: production
CBT_APP_ENV=production
CBT_APP_DEBUG=false

# Base URL — isi dengan domain CBT Anda (misal: https://cbt.sekolah.sch.id atau kosongkan untuk auto-detect)
CBT_BASE_URL=

# Domain aplikasi — sama dengan CBT_BASE_URL tanpa trailing slash (atau kosongkan untuk auto-detect)
CURRENT_APP_URL=

# Mail / SMTP Settings
CBT_SMTP_HOST=smtp.gmail.com
CBT_SMTP_PORT=587
CBT_SMTP_USER=
CBT_SMTP_PASS=
CBT_MAIL_FROM=noreply@veyracreative.site
CBT_MAIL_NAME="Veyra CBT Online"

# SSO Secret Key — SAMA dengan SSO_SECRET_KEY di Veyra Educate
SSO_SECRET_KEY=d65585e5da280c4f036b8f1b6e9ff6cfe4c061b59515c379b6842f7023f21ebb9a1b2c3d4e5f60718293a4b5c6d7e8f9